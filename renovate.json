{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "html": {
    "enabled": false,
    "managerFilePatterns": [
        "/\\.html?$/"
    ],
    "versioning": "semver",
    "digest": {
      "enabled": true
    },
    "pinDigests": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^index\\.html$"
      ],
      "matchStrings": [
        "<script src=\"https://core\\.spreedly\\.com/iframe/iframe-(?<currentValue>.*?)\\.min\\.js\""
      ],
      "depNameTemplate": "spreedly-iframe",
      "datasourceTemplate": "custom.spreedly-iframe"
    }
  ],
  "customDatasources": {
    "spreedly-iframe": {
      "defaultRegistryUrlTemplate": "https://developer.spreedly.com/docs/iframe-integrity-hashes#iframe-active-versions",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "matchDatasources": [
        "custom.spreedly-iframe"
      ],
      "extractVersion": "/iframe-(?<version>\\d+.\\d+)\\.min\\.js$"
    }
  ]
}
